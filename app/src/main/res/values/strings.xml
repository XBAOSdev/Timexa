    <!--
      「数字 + 单位」一律走 plurals，而不是用 string 拼出来：
      英文要区分 day / days、中文只有一种写法，把规则交给系统按语言选，
      代码里就不会出现 `if (n == 1)` 这种把语法硬编码进逻辑的写法。
      ⚠ 三份 strings.xml 里的 quantity 数量保持一致（都写 one + other）：
        中文虽然只有 other 会命中，少写一项会让「多语言条目对齐」的自检报不一致。
      ⚠ calc_days_unit 是**不带数字**的量词（天数输入框后面那个「天 / day / days」），
        所以它没有格式化参数，只靠 quantity 选单复数。
    -->
    <plurals name="calc_days">
        <item quantity="one">%1$d 天</item>
        <item quantity="other">%1$d 天</item>
    </plurals>
    <plurals name="calc_weeks">
        <item quantity="one">%1$d 周</item>
        <item quantity="other">%1$d 周</item>
    </plurals>
    <plurals name="calc_days_unit">
