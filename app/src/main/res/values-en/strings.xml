    <!-- ========== Permissions: banner shown before requesting ========== -->
    <string name="perm_location_banner">Approximate location is used to compute sun altitude and sunrise/sunset for your city. Coordinates are used only for on-device calculation — never uploaded, never used for anything else.</string>
    <string name="perm_notification_banner">Notification access is used to keep the remaining time in the shade while timing, and to alert you when a phase ends. Timing works fine without it — you just will not see notifications.</string>

    <!-- ========== Permissions page ========== -->
    <string name="settings_permissions">Permissions</string>
    <string name="settings_permissions_desc">See which permissions this app uses and why</string>
    <string name="perm_page_title">Permissions</string>
    <string name="perm_page_intro">This is an offline utility. Most features need no permission at all. Below is the complete list of permissions the app may request, each with its exact purpose. Every one serves only the matching feature — never analytics, profiling, or third-party sharing.</string>
    <string name="perm_page_section_manual">Permissions you grant manually</string>
    <string name="perm_page_section_manual_desc">These are requested only when you actually use the matching feature. If you decline, the feature degrades gracefully but the app keeps working.</string>
    <string name="perm_page_section_auto">Permissions granted automatically</string>
    <string name="perm_page_section_auto_desc">These are granted at install time and normally involve no private information. They are listed here only for completeness.</string>
    <string name="perm_page_footer">All data stays on your phone, in the app private directory. Nothing is collected, uploaded, or shared. Uninstalling removes everything.</string>

    <string name="perm_location_name">Approximate location (ACCESS_COARSE_LOCATION)</string>
    <string name="perm_location_use">Lets “Sun Info” compute sun altitude, sunrise/sunset, and day length for your city.\n\n· One fix only — no continuous or background tracking\n· Approximate location only; city-level is enough for the maths\n· Coordinates are used on-device only, never uploaded or shared\n· If declined, Sun Info falls back to manual coordinates</string>

    <string name="perm_notification_name">Notifications (POST_NOTIFICATIONS)</string>
    <string name="perm_notification_use">Keeps the timing status in the notification shade and alerts you when a pomodoro phase ends.\n\n· Required on Android 13 and above; granted automatically below that\n· Notification content is limited to timing status and remaining time\n· If declined, the foreground service still runs — you just see no notification</string>

    <string name="perm_vibrate_name">Vibration (VIBRATE)</string>
    <string name="perm_vibrate_use">Provides a light tap when a breathing session ends or a pomodoro phase changes.\n\n· Short pulses only — never continuous vibration\n· Can be disabled per feature in Settings</string>

    <string name="perm_internet_name">Network access (INTERNET)</string>
    <string name="perm_internet_use">Used only for the home screen to check whether a new version exists (reading a fixed version file).\n\n· No personal data is uploaded\n· Everything else works fully offline</string>

    <string name="perm_foreground_name">Foreground service (FOREGROUND_SERVICE · SPECIAL_USE)</string>
    <string name="perm_foreground_use">Lets timing continue after you leave the app. The system requires an ongoing notification to be hosted by a foreground service, hence this permission.\n\n· Runs only while a stopwatch or pomodoro is timing; stops when timing stops\n· No background computation, no network wakeups, no reading of other apps’ data</string>
</resources>
