<?xml version="1.0" encoding="utf-8"?>
<!--
  权限申请原因横幅：顶部贴边的窄条，用于在系统权限弹窗弹出前先说明用途。
  形态：卡片底板（surface + 1dp 描边 + 14dp 圆角，与全 App 卡片同款），
        不做阴影、不用强调色，避免喧宾夺主 —— 它只是「说一句话」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_banner_permission"
    android:elevation="0dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/card_padding"
    android:paddingVertical="@dimen/banner_padding_v">

    <ImageView
        android:layout_width="@dimen/banner_icon_size"
        android:layout_height="@dimen/banner_icon_size"
        android:layout_gravity="top"
        android:layout_marginTop="@dimen/banner_icon_top"
        android:contentDescription="@null"
        android:src="@drawable/ic_info"
        app:tint="@color/accent" />

    <TextView
        android:id="@+id/banner_text"
        style="@style/Text.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/drawable_text_gap"
        android:layout_weight="1"
        android:lineSpacingExtra="@dimen/line_spacing_tight"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        tools:text="获取大致位置，用于计算当地太阳高度角与日出日落时刻；坐标仅在本机计算，不会上传。" />
</LinearLayout>
