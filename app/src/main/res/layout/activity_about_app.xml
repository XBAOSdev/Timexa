<?xml version="1.0" encoding="utf-8"?>
<!--
  关于：品牌区（Hero）+ 更新提示条 + 简介卡 + 应用信息卡。

  改版思路（在莫兰迪纯色体系内做层次，不加阴影、不加渐变）：
    · 头部从「又一张白卡」换成 accent_tint 纯色块 —— 关于页原本自上而下全是同款白卡，
      没有任何重量差，整页读起来是「平」的；换成有色头部之后立刻有了头/身/尾，
      这也是应用商店介绍页的通行结构（头部承载品牌，下面才是信息）。
    · 应用图标 72 → 96dp，应用名保持 text_large_title 并加一行短标语，
      让头部有明确的视觉锚点。
    · 更新提示从一枚小胶囊改为整宽可点条（bg_update_banner，与设置页顶部同款），
      附带一行副标题说明点了会发生什么。
    · 应用信息从一段三行纯文本改为「标签 / 取值」信息行，长文案自动落到第二行，
      中英繁三种语言的长度差不会再撑破行。

  ⚠ 内容区自己留 screen_padding（根布局不写），顶栏那条分割线才能通栏。
  ⚠ 这里所有控件都是静态 inflate 的，BaseActivity.onContentChanged 里那趟
    PressFeedback.attachTree 扫得到，不需要手工挂按压反馈。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    tools:context=".appsys.About_App">

    <include layout="@layout/item_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:clipToPadding="false"
        android:paddingTop="@dimen/topbar_gap"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_l">

            <!-- ==================== 品牌区 ==================== -->
            <LinearLayout
                android:id="@+id/about_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="@dimen/space_xl"
                android:paddingEnd="@dimen/card_padding"
                android:paddingBottom="@dimen/space_xl">

                <ImageView
                    android:id="@+id/app_icon"
                    android:layout_width="@dimen/icon_avatar_size"
                    android:layout_height="@dimen/icon_avatar_size"
                    android:contentDescription="@string/app_icon_desc"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:id="@+id/app_name"
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/app_name"
                    android:textSize="@dimen/text_large_title" />

                <TextView
                    android:id="@+id/about_tagline"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/about_tagline"
                    android:textColor="@color/text_secondary" />

                <!--
                  版本胶囊：整块的唯一可点元素，点它弹出「升级方式」选择。
                  提示文案与它是同一个入口，两条路都走到同一个弹窗。

                  ⚠ 底色必须是 bg_chip_on_tint（白），不能用 bg_chip_running ——
                    后者的底色与 Hero 同为 accent_tint，叠上去等于没有底色。
                  ⚠ 文字取 accent_deep 而不是 accent：accent 在白底上只有约 3.0:1，
                    deep 那一档能到约 4.4:1，是这个字号下更稳的选择。
                -->
                <TextView
                    android:id="@+id/app_version"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_chip_on_tint"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/badge_padding_h"
                    android:paddingTop="@dimen/badge_padding"
                    android:paddingEnd="@dimen/badge_padding_h"
                    android:paddingBottom="@dimen/badge_padding"
                    android:text="@string/version_placeholder"
                    android:textColor="@color/accent_deep" />
            </LinearLayout>

            <!--
              更新提示条：仅在检测到新版本时可见（代码控制）。
              整条可点，右侧箭头表示「点了还有一步」—— 点开的是升级方式选择，不是直接跳浏览器。
            -->
            <LinearLayout
                android:id="@+id/new_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_update_banner"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding_h"
                android:paddingTop="@dimen/row_padding_v"
                android:paddingEnd="@dimen/row_padding_h"
                android:paddingBottom="@dimen/row_padding_v"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/new_version_title"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        tools:text="发现新版本 1.2.0" />

                    <TextView
                        android:id="@+id/new_version_desc"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/about_update_desc" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_chevron_size"
                    android:layout_height="@dimen/icon_chevron_size"
                    android:layout_marginStart="@dimen/space_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/accent" />
            </LinearLayout>

            <!-- ==================== 简介 ==================== -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_intro" />

                <TextView
                    style="@style/Text.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:lineSpacingExtra="@dimen/line_spacing"
                    android:text="@string/app_description"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- ==================== 应用信息 ==================== -->
            <!--
              padding 覆盖为 0：每一行自己负责内边距，行之间的分隔线才能左侧内缩、
              右侧通到卡片边缘（与设置页、功能列表的分组卡片是同一套做法）。
            -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="vertical"
                android:padding="0dp">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/row_padding_h"
                    android:paddingTop="@dimen/row_padding_v"
                    android:paddingEnd="@dimen/row_padding_h"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="@string/developer_title" />

                <!-- 开发者 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/row_padding_h"
                    android:paddingTop="@dimen/row_padding_v"
                    android:paddingEnd="@dimen/row_padding_h"
                    android:paddingBottom="@dimen/row_padding_v">

                    <TextView
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_info_developer" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/about_developer_name"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/divider_inset"
                    android:background="@color/stroke_soft" />

                <!-- 官方网站：点 → 打开主站 -->
                <LinearLayout
                    android:id="@+id/about_site"
                    style="@style/Card.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/row_padding_h"
                    android:paddingTop="@dimen/row_padding_v"
                    android:paddingEnd="@dimen/row_padding_h"
                    android:paddingBottom="@dimen/row_padding_v">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_info_site" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/official_site"
                            android:textColor="@color/accent_deep" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_chevron_size"
                        android:layout_height="@dimen/icon_chevron_size"
                        android:layout_marginStart="@dimen/space_s"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/divider_inset"
                    android:background="@color/stroke_soft" />

                <!-- 开源许可：点 → 弹窗看完整许可文本 -->
                <LinearLayout
                    android:id="@+id/about_license"
                    style="@style/Card.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/row_padding_h"
                    android:paddingTop="@dimen/row_padding_v"
                    android:paddingEnd="@dimen/row_padding_h"
                    android:paddingBottom="@dimen/row_padding_v">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_licenses" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/about_license_value"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_chevron_size"
                        android:layout_height="@dimen/icon_chevron_size"
                        android:layout_marginStart="@dimen/space_s"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/divider_inset"
                    android:background="@color/stroke_soft" />

                <!-- AI 提示：纯告知，不可点（所以不给箭头、不用 Card.Row） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/row_padding_h"
                    android:paddingTop="@dimen/row_padding_v"
                    android:paddingEnd="@dimen/row_padding_h"
                    android:paddingBottom="@dimen/row_padding_v">

                    <TextView
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_info_ai" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/about_ai_value"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/line_spacing_tight"
                android:text="@string/copyright_info" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
