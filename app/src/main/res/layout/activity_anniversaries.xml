<?xml version="1.0" encoding="utf-8"?>
<!--
  纪念日倒数。
  与秒表页同构：统一顶栏 ／ 中部列表（空态有引导）／ 底部等宽按钮。
  每行的可交互区域都带视觉线索：日期小字前缀铅笔图标（改日期与重复方式）、
  右侧两枚圆形按钮（同步到系统日历 / 删除），名称本身点击可重命名。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    tools:context=".appsys.Anniversaries">

    <include layout="@layout/item_topbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/topbar_gap"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/anniversary_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_m" />
        </ScrollView>

        <TextView
            android:id="@+id/anniversary_empty"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_xl"
            android:text="@string/anniversary_empty"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- 内容区与底部操作条的交界：1dp hairline -->
    <include layout="@layout/item_bottom_divider" />

    <TextView
        android:id="@+id/anniversary_add"
        style="@style/Btn.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginBottom="@dimen/screen_padding_bottom"
        android:text="@string/anniversary_add" 
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"/>
</LinearLayout>
