<?xml version="1.0" encoding="utf-8"?>
<!--
  纪念日列表行：上下两级。

  为什么从「一行塞五件东西」改成两级：
    旧版把 名称 / 日期 / 倒数天数 / 同步圆钮 / 删除圆钮 全压在一条水平线上，
    倒数天数还会随文案变宽（「还有 128 天」比「就是今天」长一倍），
    于是名称被挤成一小截、整行看起来「糊」在一起。
    拆成两级之后，每一级最多两个元素：上行「名称 + 天数」、下行「日期 + 两枚圆钮」，
    任何语言下都不会互相抢宽度。

  为什么天数单独放上行右侧、而不是留在下行：
    它是这一行唯一的结论（用户扫列表时真正要读的就是它），
    放在视线第一落点上、并且给一档展示字号（text_counter_display），
    扫一眼就能横着比出哪个日子更近。

  ⚠ 根布局**不挂** `@style/Card.Row`：那个样式带 clickable=true。
    旧版根节点挂了它却没设点击监听，于是点空白处会按下变色、却什么也不发生 ——
    一个「看着能点其实不能点」的假热区。现在只让真正有行为的两段文字自己 clickable。

  ⚠ 这一行是**动态 inflate** 出来的（见 Anniversaries.buildRow），
    BaseActivity 里那趟 PressFeedback.attachTree 扫不到它，
    四个可交互控件必须在代码里各自 attach —— 改布局时别把 id 改掉。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/row_padding_h"
    android:paddingTop="@dimen/row_padding_v"
    android:paddingEnd="@dimen/row_padding_h"
    android:paddingBottom="@dimen/row_padding_v">

    <!-- 第一级：名称（可点改名） + 倒数天数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
          名称与改名铅笔要挨在一起，所以名称用 wrap_content 而不是撑满：
          写成 match_parent / 自己带 weight 时，drawableEnd 会被顶到这一级的右端，
          中间空出一大片，铅笔看起来像悬在半空、还容易被误读成「天数」的附属图标。
          外层这一格带 weight 负责「把天数挤到右边」，同时给名称一个宽度上限 ——
          超长名字在这里被 ellipsize，不会把天数顶出屏幕。
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/anniversary_name"
                style="@style/Text.Row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_tappable"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_rename"
                android:drawablePadding="@dimen/drawable_text_gap"
                android:drawableTint="@color/text_tertiary"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="1"
                android:paddingVertical="@dimen/space_xxs" />
        </LinearLayout>

        <TextView
            android:id="@+id/anniversary_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="@dimen/text_counter_display"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第二级：日期（可点改日期） + 同步 / 删除 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/anniversary_date"
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_row_tappable"
            android:clickable="true"
            android:drawableStart="@drawable/ic_edit"
            android:drawablePadding="@dimen/drawable_text_gap"
            android:drawableTint="@color/text_tertiary"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="1"
            android:paddingVertical="@dimen/space_xxs" />

        <ImageButton
            android:id="@+id/anniversary_sync"
            android:layout_width="@dimen/icon_button_size_small"
            android:layout_height="@dimen/icon_button_size_small"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/anniversary_sync"
            android:padding="@dimen/row_action_padding_small"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_calendar"
            app:tint="@color/accent" />

        <ImageButton
            android:id="@+id/anniversary_delete"
            android:layout_width="@dimen/icon_button_size_small"
            android:layout_height="@dimen/icon_button_size_small"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/anniversary_delete"
            android:padding="@dimen/row_action_padding_small"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="@color/danger" />
    </LinearLayout>
</LinearLayout>
