<?xml version="1.0" encoding="utf-8"?>
<!--
  首页功能入口卡片：两枚可直接点击的入口行。
  与列表页共用同一套卡片结构（一卡多行 + 单侧内缩分隔线），保证全 App 卡片形态一致。
  整行可点（含按压反馈），不会出现“只有文字能点、留白点不动”的抠手体验。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- 感受时间 -->
    <LinearLayout
        android:id="@+id/T_ganshoushijian"
        style="@style/Card.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/row_min_height_icon"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/row_padding_h"
        android:paddingVertical="@dimen/row_padding_v">

        <ImageView
            android:layout_width="@dimen/icon_badge_size"
            android:layout_height="@dimen/icon_badge_size"
            android:background="@drawable/bg_icon_badge"
            android:contentDescription="@null"
            android:padding="@dimen/icon_badge_padding"
            android:src="@drawable/ic_cloud"
            app:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_row_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_feel_time" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/home_feel_time_desc" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_chevron_size"
            android:layout_height="@dimen/icon_chevron_size"
            android:layout_marginStart="@dimen/space_s"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/divider_inset"
        android:background="@color/stroke_soft" />

    <!-- 应用集 -->
    <LinearLayout
        android:id="@+id/T_yingyongji"
        style="@style/Card.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/row_min_height_icon"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/row_padding_h"
        android:paddingVertical="@dimen/row_padding_v">

        <ImageView
            android:layout_width="@dimen/icon_badge_size"
            android:layout_height="@dimen/icon_badge_size"
            android:background="@drawable/bg_icon_badge"
            android:contentDescription="@null"
            android:padding="@dimen/icon_badge_padding"
            android:src="@drawable/ic_timer"
            app:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_row_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_apps" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/home_apps_desc" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_chevron_size"
            android:layout_height="@dimen/icon_chevron_size"
            android:layout_marginStart="@dimen/space_s"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_tertiary" />
    </LinearLayout>
</LinearLayout>
